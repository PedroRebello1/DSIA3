# Copie para .env e ajuste se necessário (cp .env.example .env).

# Banco (usado pelo docker compose)
POSTGRES_USER=steam
POSTGRES_PASSWORD=steam
POSTGRES_DB=steam
POSTGRES_PORT=5432

# API
API_PORT=8000
DEFAULT_K=10
ARTIFACTS_DIR=artifacts

# Usado ao rodar a API fora do Docker (banco do compose exposto na porta local)
DATABASE_URL=postgresql+psycopg://steam:steam@localhost:5432/steam

# Serviço init (opcionais)
# FORCE_TRAIN=1                 # retreina mesmo se o modelo já existir
# TRAIN_ARGS=--no-search        # argumentos extras de "python -m recsys.train"
# DATASET_URL=https://...       # origem alternativa do steam.zip
